+# Reproducible builds: walk directories in name order, not in the filesystem's order, so the
+# same files give the same assets image on every machine (srmodels.bin, index.json).
+_os_walk = os.walk
+
+
+def _sorted_walk(top, *args, **kwargs):
+    for root, dirs, files in _os_walk(top, *args, **kwargs):
+        dirs.sort()
+        files.sort()
+        yield root, dirs, files
+
+
+os.walk = _sorted_walk
+
 
